{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/check-package-manager.mjs",
    "build": "pnpm run typecheck && pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/clientflow run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/jsdom": "^30.0.0",
    "@types/supertest": "7.2.1",
    "drizzle-orm": "0.45.4",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "supertest": "7.3.1",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
