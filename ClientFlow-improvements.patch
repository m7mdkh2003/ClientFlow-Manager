+  display: grid;
+  gap: 2px;
+  flex: 1;
+}
+.profile-strip strong {
+  color: #e6e8db;
+  font-size: 11px;
+  font-weight: 600;
+}
+.profile-strip span {
+  color: #95a69c;
+  font-size: 10px;
+}
+.profile-strip > svg {
+  color: #a4b3a9;
+}
+.profile-logout {
+  display: grid;
+  width: 30px;
+  height: 30px;
+  flex: none;
+  place-items: center;
+  padding: 0;
