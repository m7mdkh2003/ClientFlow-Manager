+export function TasksPage({
+  tasks,
+  projects = [],
+  clients = [],
+  loading,
+  error,
+  retry,
+  openEditor,
+  onDelete,
+  onMoveTask,
+  search,
+  setSearch,
+  readOnly = false,
+  embedded = false,
+}: PageState &
+  SearchState & {
+    tasks: Task[];
+    projects?: Project[];
+    clients?: Client[];
+    openEditor: EditorAction;
+    onDelete: DeleteAction;
+    onMoveTask: MoveAction;
+  }) {
+  const [filters, setFilters] = useState<TaskFilters>({ ...emptyTaskFilters });
+  const visible = filterTasks(tasks, projects, filters);
+  const filtered =
+    Object.entries(filters).some(
+      ([key, value]) => value !== emptyTaskFilters[key as keyof TaskFilters],
+    ) || Boolean(search);
+  const updateFilter = (key: keyof TaskFilters, value: string) =>
+    setFilters((previous) => ({
+      ...previous,
+      [key]: value,
+      ...(key === "clientId" ? { projectId: "all" } : {}),
+    }));
+  const reset = () => {
+    setFilters({ ...emptyTaskFilters });
+    setSearch("");
+  };
+  const actions = (
+    <div className="heading-actions">
+      <ExportButton
+        kind="tasks"
+        rows={[
+          [
+            "Task",
+            "Project",
+            "Client",
+            "Status",
+            "Priority",
+            "Due date",
+            "Description",
+          ],
+          ...visible.map((t) => [
+            t.title,
+            t.projectName,
+            t.clientName,
+            t.status,
+            t.priority,
+            t.dueDate?.slice(0, 10),
+            t.description,
+          ]),
+        ]}
+      />
+      {!readOnly && (
+        <AddButton
+          label="Add task"
+          onClick={() => openEditor({ kind: "task" })}
+          testId="button-create-task"
+        />
+      )}
+    </div>
+  );
+  return (
+    <>
+      {!embedded ? (
+        <PageHeading
+          eyebrow="TODAY, AND WHAT’S NEXT"
+          title="Tasks"
+          description="Filter by client, project, priority, or deadline to find your next step."
+          action={actions}
+        />
+      ) : (
+        <div className="section-heading">
+          <h2>Project tasks</h2>
+          {actions}
+        </div>
+      )}
+      <div className="task-summary-strip">
+        <span>
+          <Circle size={15} />
+          {visible.filter((t) => t.status === "todo").length} to do
+        </span>
+        <span>
+          <Clock3 size={15} />
+          {visible.filter((t) => t.status === "in_progress").length} in progress
+        </span>
+        <span>
+          <CheckCheck size={15} />
+          {visible.filter((t) => t.status === "done").length} done
+        </span>
+        <div className="summary-search">
+          <SearchBox
+            value={search}
+            onChange={setSearch}
+            placeholder="Search tasks"
+          />
+        </div>
+      </div>
+      <div className="task-filters" aria-label="Task filters">
+        {!embedded && (
+          <>
+            <label>
+              Client
+              <select
+                value={filters.clientId}
+                onChange={(e) => updateFilter("clientId", e.target.value)}
+                data-testid="filter-client"
+              >
+                <option value="all">All clients</option>
+                {clients.map((c) => (
+                  <option key={c.id} value={c.id}>
+                    {c.name}
+                  </option>
+                ))}
+              </select>
+            </label>
+            <label>
+              Project
+              <select
+                value={filters.projectId}
+                onChange={(e) => updateFilter("projectId", e.target.value)}
+                data-testid="filter-project"
+              >
+                <option value="all">All projects</option>
+                {projects
+                  .filter(
+                    (p) =>
+                      filters.clientId === "all" ||
+                      String(p.clientId) === filters.clientId,
+                  )
+                  .map((p) => (
+                    <option key={p.id} value={p.id}>
+                      {p.name}
+                    </option>
+                  ))}
+              </select>
+            </label>
+          </>
+        )}
+        <label>
+          Priority
+          <select
+            value={filters.priority}
+            onChange={(e) => updateFilter("priority", e.target.value)}
+            data-testid="filter-priority"
+          >
+            <option value="all">All priorities</option>
+            <option value="high">High</option>
+            <option value="medium">Medium</option>
+            <option value="low">Low</option>
+          </select>
+        </label>
+        <label>
+          Deadline
+          <select
+            value={filters.due}
+            onChange={(e) => updateFilter("due", e.target.value)}
+            data-testid="filter-due"
+          >
+            <option value="all">Any deadline</option>
+            <option value="overdue">Overdue</option>
+            <option value="today">Due today</option>
+            <option value="week">Next 7 days</option>
+            <option value="undated">No due date</option>
+          </select>
+        </label>
+        <label>
+          Sort by
+          <select
+            value={filters.sort}
+            onChange={(e) => updateFilter("sort", e.target.value)}
+            data-testid="filter-sort"
+          >
+            <option value="due">Due date</option>
+            <option value="priority">Priority</option>
+            <option value="newest">Newest first</option>
+          </select>
+        </label>
+        {filtered && (
+          <Button
