new file mode 100644
index 0000000..62c1e3f
--- /dev/null
+++ b/tests/db.ts
@@ -0,0 +1,15 @@
+import { PGlite } from "@electric-sql/pglite";
+import { drizzle } from "drizzle-orm/pglite";
+import * as schema from "../lib/db/src/schema";
+export * from "../lib/db/src/schema";
+export const pgReview = new PGlite();
+await pgReview.exec(`
+CREATE TYPE project_status AS ENUM ('planning','active','completed');
+CREATE TYPE task_status AS ENUM ('todo','in_progress','done');
+CREATE TYPE task_priority AS ENUM ('low','medium','high');
+CREATE TABLE clients (id SERIAL PRIMARY KEY, owner_id TEXT, name TEXT NOT NULL, company TEXT, email TEXT, phone TEXT, notes TEXT, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), UNIQUE(owner_id,id));
+CREATE TABLE projects (id SERIAL PRIMARY KEY, owner_id TEXT, name TEXT NOT NULL, client_id INTEGER NOT NULL REFERENCES clients(id), description TEXT, status project_status NOT NULL DEFAULT 'planning', deadline DATE, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), UNIQUE(owner_id,id), FOREIGN KEY(owner_id,client_id) REFERENCES clients(owner_id,id));
+CREATE TABLE tasks (id SERIAL PRIMARY KEY, owner_id TEXT, project_id INTEGER NOT NULL REFERENCES projects(id), title TEXT NOT NULL, description TEXT, status task_status NOT NULL DEFAULT 'todo', priority task_priority NOT NULL DEFAULT 'medium', due_date DATE, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), UNIQUE(owner_id,id), FOREIGN KEY(owner_id,project_id) REFERENCES projects(owner_id,id));
+`);
+export const db = drizzle(pgReview, { schema });
+export const pool = { end: () => pgReview.close() };
diff --git a/tests/workspace-utils.test.ts b/tests/workspace-utils.test.ts
new file mode 100644
index 0000000..6a020b4
--- /dev/null
+++ b/tests/workspace-utils.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from "vitest";
+import {
+  dateInDays,
+  dueState,
+  emptyTaskFilters,
+  filterTasks,
+  toCsv,
+} from "../artifacts/clientflow/src/lib/workspace";
+import type { Project, Task } from "../lib/api-client-react/src";
+const projects = [
+  { id: 1, clientId: 11 },
+  { id: 2, clientId: 22 },
+] as Project[];
+const task = (id: number, values: Partial<Task> = {}): Task => ({
+  id,
+  title: `Task ${id}`,
+  projectId: 1,
+  projectName: "Site",
+  clientName: "Client",
+  description: null,
+  status: "todo",
+  priority: "medium",
+  dueDate: null,
+  createdAt: "2026-10-01T00:00:00Z",
+  ...values,
+});
+const tasks = [
+  task(1, { dueDate: "2026-10-23", priority: "high" }),
+  task(2, { dueDate: "2026-10-24" }),
+  task(3, { dueDate: "2026-10-25", projectId: 2 }),
+  task(4, { dueDate: "2026-10-20", status: "done" }),
+  task(5),
+];
+describe("task deadlines and filters", () => {
+  it("separates overdue, today, future and completed tasks", () => {
+    expect(tasks.map((t) => dueState(t, "2026-10-24"))).toEqual([
+      "overdue",
+      "today",
+      "upcoming",
+      "none",
+      "none",
+    ]);
+  });
+  it("filters by client ID and project, rather than by a display name", () => {
+    expect(
+      filterTasks(
+        tasks,
+        projects,
+        { ...emptyTaskFilters, clientId: "22" },
+        "2026-10-24",
+      ).map((t) => t.id),
+    ).toEqual([3]);
+    expect(
+      filterTasks(
+        tasks,
+        projects,
+        { ...emptyTaskFilters, projectId: "2", priority: "high" },
+        "2026-10-24",
+      ),
+    ).toEqual([]);
+  });
+  it("shows unfinished overdue tasks and excludes undated tasks from this week", () => {
+    expect(
+      filterTasks(
+        tasks,
+        projects,
+        { ...emptyTaskFilters, due: "overdue" },
+        "2026-10-24",
+      ).map((t) => t.id),
+    ).toEqual([1]);
+    expect(
+      filterTasks(
+        tasks,
+        projects,
+        { ...emptyTaskFilters, due: "week" },
+        "2026-10-24",
+      ).map((t) => t.id),
+    ).toEqual([2, 3]);
+    expect(
+      filterTasks(
+        tasks,
+        projects,
+        { ...emptyTaskFilters, due: "undated" },
+        "2026-10-24",
+      ).map((t) => t.id),
+    ).toEqual([5]);
+  });
+  it("does not mutate the source list when sorting", () => {
+    const ids = tasks.map((t) => t.id);
+    filterTasks(
+      tasks,
+      projects,
+      { ...emptyTaskFilters, sort: "priority" },
+      "2026-10-24",
+    );
+    expect(tasks.map((t) => t.id)).toEqual(ids);
+  });
+  it("advances dates across the end of the year", () => {
+    expect(dateInDays(2, new Date(2026, 11, 30, 12))).toBe("2027-01-01");
+  });
+});
+it("exports Unicode, commas, quotes, newlines and formula-like content safely", () => {
+  const csv = toCsv([
+    ["Name", "Notes"],
+    ["محمد", 'Hello, "world"\nAgain'],
+    ["=SUM(A1:A2)", "@formula"],
+  ]);
+  expect(csv).toContain('"محمد","Hello, ""world""\nAgain"');
+  expect(csv).toContain('"\'=SUM(A1:A2)"');
+  expect(csv).toContain('"\'@formula"');
+});
diff --git a/tests/workspace.test.tsx b/tests/workspace.test.tsx
new file mode 100644
index 0000000..115888e
--- /dev/null
+++ b/tests/workspace.test.tsx
@@ -0,0 +1,427 @@
+import { afterAll, beforeAll, expect, it, vi } from "vitest";
+import request from "supertest";
+import { JSDOM } from "jsdom";
+import { pool } from "@workspace/db";
+import React, { act } from "react";
+import type { Root } from "react-dom/client";
+vi.mock("@clerk/express", async () => {
+  const { testIdentity } = await import("./clerk");
+  return {
+    getAuth: () => ({ userId: testIdentity.userId }),
+    clerkMiddleware: () => (_req: unknown, _res: unknown, next: () => void) =>
+      next(),
+  };
+});
+import app from "../artifacts/api-server/src/app";
+let dom: JSDOM;
+let root: Root;
+let AppComponent: React.ComponentType;
+let apiCalls: Array<{ method: string; path: string; status: number }> = [];
+const byId = (id: string) =>
+  document.querySelector(`[data-testid="${id}"]`) as HTMLElement;
+async function settle() {
+  await act(async () => {
+    await new Promise((r) => setTimeout(r, 65));
+  });
+}
+async function waitFor(predicate: () => unknown) {
+  for (let i = 0; i < 160; i++) {
+    await settle();
+    if (predicate()) return;
+  }
+  throw new Error(
+    "Timed out waiting for UI: " +
+      document.body.innerHTML?.slice(-2000) +
+      " URL:" +
+      location.href +
+      " calls:" +
+      JSON.stringify(apiCalls),
+  );
+}
+async function click(id: string) {
+  const el = byId(id);
+  expect(el, "Missing " + id).toBeTruthy();
+  await act(async () => el.click());
+  await settle();
+}
+async function fill(id: string, value: string) {
+  const el = byId(id) as HTMLInputElement;
+  expect(el, "Missing " + id).toBeTruthy();
+  await act(async () => {
+    const proto =
+      el.tagName === "SELECT"
+        ? dom.window.HTMLSelectElement.prototype
+        : el.tagName === "TEXTAREA"
+          ? dom.window.HTMLTextAreaElement.prototype
+          : dom.window.HTMLInputElement.prototype;
+    Object.getOwnPropertyDescriptor(proto, "value")!.set!.call(el, value);
+    el.dispatchEvent(
+      new dom.window.Event(el.tagName === "SELECT" ? "change" : "input", {
+        bubbles: true,
+      }),
+    );
+    el.dispatchEvent(new dom.window.Event("change", { bubbles: true }));
+  });
+}
+async function submit(kind: string) {
+  await act(async () => {
+    byId("form-" + kind).dispatchEvent(
+      new dom.window.Event("submit", { bubbles: true, cancelable: true }),
+    );
+  });
+  await waitFor(() => !byId("form-" + kind));
+}
