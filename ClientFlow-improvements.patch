+.sidebar-note p {
+  margin: 13px 0 3px;
+  font-family: var(--font-serif);
+  font-size: 14px;
+  font-weight: 700;
+  letter-spacing: -0.3px;
+}
+.sidebar-note > span:last-child {
+  color: #aab9af;
+  font-size: 11px;
+}
+.profile-strip {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-top: 15px;
+  padding: 13px 5px 2px;
+  border-top: 1px solid #3a554c;
+}
+.profile-avatar {
+  display: grid;
+  width: 32px;
+  height: 32px;
+  flex: none;
+  place-items: center;
+  color: #274138;
+  background: #d4c2a2;
+  border-radius: 50%;
+  font-family: var(--font-serif);
+  font-size: 13px;
+  font-weight: 800;
+}
