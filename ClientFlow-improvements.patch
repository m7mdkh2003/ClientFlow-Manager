-.project-overview { display:grid; grid-template-columns:auto auto 1fr; align-items:center; gap:clamp(17px,4vw,50px); min-height:104px; margin-bottom:18px; padding:17px 21px; background:#e9e6d7; border:1px solid #e0dccb; border-radius:12px; }
