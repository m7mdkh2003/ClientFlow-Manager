-.mini-bar:nth-child(3n+1) { --bar-height:38px; }.mini-bar:nth-child(3n+2) { --bar-height:22px; }.mini-bar:nth-child(3n) { --bar-height:31px; }
-.mini-bar.planning { background:#ddb969; }.mini-bar.completed { background:#bbc1a9; }
