+body {
+  min-width: 320px;
+  background: #f4f1e8;
+}
+button,
+a,
+input,
+select,
+textarea {
+  -webkit-tap-highlight-color: transparent;
+}
+button,
+a {
+  transition:
+    color 0.18s ease,
+    background-color 0.18s ease,
+    border-color 0.18s ease,
+    transform 0.18s ease,
+    opacity 0.18s ease;
+}
+.app-frame {
+  min-height: 100dvh;
+  color: #263c37;
+  background: #f4f1e8;
+}
+.sidebar {
+  position: fixed;
+  z-index: 30;
+  inset: 0 auto 0 0;
+  display: flex;
+  width: 244px;
+  flex-direction: column;
+  padding: 27px 17px 16px;
+  color: #eae9dc;
+  background: #203b35;
+}
+.brand-lockup {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  padding: 0 13px;
+  color: #f6f1e5;
+  font-family: var(--font-serif);
+  font-size: 21px;
+  font-weight: 800;
+  letter-spacing: -1.2px;
+}
+.brand-mark {
+  display: grid;
+  width: 31px;
+  height: 31px;
+  place-items: center;
+  color: #203b35;
+  background: #e8bf6c;
+  border-radius: 10px 10px 10px 3px;
+}
+.brand-period {
+  color: #e8bf6c;
+}
+.workspace-label {
+  margin: 48px 13px 12px;
+  color: #91a59b;
+  font: 500 9px var(--font-mono);
+  letter-spacing: 1.3px;
+}
+.side-nav {
+  display: grid;
+  gap: 5px;
+}
+.nav-link {
+  display: flex;
+  align-items: center;
+  gap: 13px;
+  min-height: 44px;
+  padding: 0 13px;
+  color: #c4d0c9;
+  border-radius: 9px;
+  font-size: 13px;
+  font-weight: 500;
+  text-decoration: none;
+}
+.nav-link:hover {
+  color: #fff4da;
+  background: rgba(255, 255, 255, 0.07);
+}
+.nav-link.nav-active {
+  color: #283b34;
+  background: #e8bf6c;
+  box-shadow: 0 5px 14px #142d2750;
+}
+.nav-count {
+  margin-left: auto;
+  display: grid;
+  width: 22px;
+  height: 22px;
+  place-items: center;
+  color: #f3ecd9;
+  background: #49645a;
+  border-radius: 7px;
+  font: 500 10px var(--font-mono);
+}
+.nav-active .nav-count {
+  color: #34483e;
+  background: #f4d994;
+}
+.sidebar-bottom {
+  margin-top: auto;
+}
+.sidebar-note {
+  position: relative;
+  padding: 17px 14px 19px;
+  overflow: hidden;
+  color: #e9e8d9;
+  background: #2b4b43;
+  border: 1px solid #3d5c51;
+  border-radius: 12px;
+}
+.sidebar-note::after {
+  position: absolute;
+  width: 82px;
+  height: 82px;
+  right: -23px;
+  bottom: -43px;
+  content: "";
+  border: 1px solid #6c8172;
+  border-radius: 50%;
+  box-shadow:
+    0 0 0 12px #314f46,
+    0 0 0 24px #2d4d43;
+  opacity: 0.5;
+}
+.note-orbit {
+  display: grid;
+  width: 27px;
+  height: 27px;
+  place-items: center;
+  color: #e8bf6c;
+  background: #3a5b50;
+  border-radius: 8px;
