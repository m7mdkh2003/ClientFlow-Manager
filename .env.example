# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://clientflow:replace_me@127.0.0.1:5432/clientflow
CLERK_SECRET_KEY=sk_test_replace_with_your_own_development_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_own_development_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_own_development_key
# Local web :3000 -> API :3001. Replit uses its existing /api service router.
API_PROXY_TARGET=http://127.0.0.1:3001
# Set only if your production Clerk/Replit setup requires a proxy URL.
# VITE_CLERK_PROXY_URL=https://your-app.example/api/__clerk
